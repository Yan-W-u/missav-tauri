{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MissAV下载器",
  "version": "2.0.0",
  "identifier": "com.missav.downloader",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MissAV 下载器",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "category": "Utility",
    "shortDescription": "MissAV 下载与在线观看",
    "longDescription": "搜索、在线观看与下载，内置 HLS 下载引擎",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
